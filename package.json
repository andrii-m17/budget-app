{
  "name": "budget-app",
  "private": true,
  "version": "2.14.0",
  "description": "Тести фінансової логіки (node:test, без залежностей) і E2E у WebKit (Playwright, devDependency): npm test, npm run e2e.",
  "scripts": {
    "test": "node --test",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --project=dark --grep @smoke",
    "e2e:cloud": "playwright test -c playwright.cloud.config.js",
    "e2e:ios": "node e2e/ios/run.mjs",
    "e2e:ios:full": "node e2e/ios/full.mjs",
    "e2e:ios:bg": "node e2e/ios/kb5.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "appium": "^3.9.0",
    "webdriverio": "^10.1.0"
  }
}
